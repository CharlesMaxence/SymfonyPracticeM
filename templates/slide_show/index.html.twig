{% extends 'base.html.twig' %}

{% block title %}{{"SlideShow index"|trans}}{% endblock %}

{% block body %}
    <h1>{{"SlideShow index"|trans}}</h1>

    <table class="table">
        <thead>
            <tr>
                <th>{{"Id"|trans}}</th>
                <th>{{"Title"|trans}}</th>
                <th>{{"actions"|trans}}</th>
            </tr>
        </thead>
        <tbody>
        {% for slide_show in slide_shows %}
            <tr>
                <td>{{ slide_show.id }}</td>
                <td>{{ slide_show.title }}</td>
                <td align='center'>
                    {{ include('actions/_action_form.html.twig', {'object': theme, 'app_delete': 'app_slide_show_delete','app_show': 'app_slide_show_show','app_edit': 'app_slide_show_edit'}) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">{{"no records found"|trans}}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_slide_show_new') }}"><button class="btn btn-primary">{{'Create new'|trans}}</button></a>
{% endblock %}
