{% extends 'base.html.twig' %}

{% block title %}{{"SlideShow"|trans}}{% endblock %}

{% block body %}
    <h1>{{"SlideShow"|trans}}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{"Id"|trans}}</th>
                <td>{{ slide_show.id }}</td>
            </tr>
            <tr>
                <th>{{"Title"|trans}}</th>
                <td>{{ slide_show.title }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_slide_show_index') }}"><button class="btn btn-primary">{{'back to list'|trans}}</button></a>

    <a href="{{ path('app_slide_show_edit', {'id': slide_show.id}) }}"><button class="btn btn-info">{{'edit'|trans}}</button></a>

    {{ include('slide_show/_delete_form.html.twig') }}
{% endblock %}
